DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/faivri
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-proj-xxx
TAVILY_API_KEY=tvly-xxx
UPSTASH_REDIS_URL=redis://default:xxx@host:port
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
DEFAULT_PROVIDER=anthropic

# ─── Faivri partner integrations ─────────────────────────────────────────
# All three are OPTIONAL. Without keys the platform falls back to managed
# providers and ships honest "powered by Anthropic/OpenAI" badges instead.

# PixVerse — video → keyframes for the /analyze/video pipeline. Falls back
# to local OpenCV mid-frame extraction when unset (no comparison visual).
PIXVERSE_API_KEY=

# GMI Cloud — preferred GPU inference fleet. Routes fast + strong calls
# through their OpenAI-compatible chat endpoint when set; otherwise every
# request lands on Anthropic / OpenAI as before.
GMI_CLOUD_API_KEY=
GMI_CLOUD_BASE_URL=https://api.gmicloud.ai/v1
GMI_CLOUD_TIMEOUT=8.0

# HydraDB — negotiation memory layer. No separate connection string;
# storage rides on the primary Postgres instance defined above.
HYDRADB_ENABLED=true
