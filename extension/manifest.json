{
  "manifest_version": 3,
  "name": "Faivri — Price Check & Negotiate",
  "version": "0.6.1",
  "description": "Spot overpriced Facebook Marketplace & eBay listings in seconds. Live market comps, seller-risk scoring, and negotiation scripts.",
  "action": {
    "default_title": "Faivri",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "activeTab", "scripting", "webNavigation", "alarms"],
  "host_permissions": [
    "https://*.ebay.com/*",
    "https://*.facebook.com/*",
    "https://*.faivri.com/*",
    "https://*.up.railway.app/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.ebay.com/itm/*"],
      "js": ["content/extract-ebay.js", "content/overlay.js", "content/seller-risk.js"],
      "css": ["content/overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.facebook.com/marketplace/*"],
      "js": ["content/extract-marketplace.js", "content/overlay.js", "content/seller-risk.js"],
      "css": ["content/overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
